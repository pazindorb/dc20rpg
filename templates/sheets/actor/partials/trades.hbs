<div class="skills-wrapper">
  {{#each skills.trades as |skill key|}}
  {{#ifCond skill.mastery '||' @root.system.sheetData.show.unknownTrades}}

    {{!-- Edit --}}
    {{#if @root.editMode}}
    <div class="skill" data-hover="tooltip" data-header="{{skill.label}}" data-uuid="{{labelFromKey key @root.config.SYSTEM_CONSTANTS.JOURNAL_UUID.tradesJournal}}">
      <span class="mastery-box expertise-box clickable {{#if skill.expertise}}active{{/if}}" style="background-color: {{color-by-key skill.baseAttribute}}" data-tooltip="{{localize "Spend Point to gain Expertise"}}"
        data-action="expertise" data-type="trades" data-key="{{key}}"
      >E</span>
      <span class="mastery-box clickable" style="background-color: {{color-by-key skill.baseAttribute}}"
        data-tooltip="{{localize "dc20rpg.sheet.skills.mastery"}}" data-rAction="masteryToggle" data-action="masteryToggle" data-type="trades" data-key="{{key}}"
      >
        {{skill.short}}
      </span>
      <input class="skill-name" type="text" {{#unless skill.custom}}disabled{{/unless}} value="{{skill.label}}" name="system.trades.{{key}}.label"/>
      <div class="skill-menu">
        <select name="system.trades.{{key}}.baseAttribute" data-tooltip="{{localize 'dc20rpg.sheet.skills.baseAttribute'}}">
          {{selectOptions @root.config.DROPDOWN_DATA.shortAttributes selected=skill.baseAttribute}}
        </select>
        {{#if skill.custom}}
        <a class="remove-skill fa-solid fa-x" data-action="removeSkill" data-type="trades" data-key="{{key}}" data-tooltip="{{localize "dc20rpg.sheet.remove"}}"></a>
        {{/if}}
      </div>
    </div>
    {{else}}
    {{!-- Display --}}
    <div class="skill" data-hover="tooltip" data-header="{{skill.label}}" data-uuid="{{labelFromKey key @root.config.SYSTEM_CONSTANTS.JOURNAL_UUID.tradesJournal}}">
      <span class="mastery-box" style="background-color: {{color-by-key skill.baseAttribute}}" data-tooltip="{{skill.masteryLabel}}">
        {{skill.short}}
      </span>
      <input class="skill-name" type="text" disabled value="{{skill.label}}"/>
      <div class="skill-menu">
        <span data-tooltip="{{skill.label}} {{localize "DC20RPG.Passive"}}">{{skill.passive}}</span>
        <a data-action="roll" data-type="check" data-key="{{key}}" data-tooltip="{{skill.label}} {{localize "DC20RPG.Check"}}">{{numberFormat skill.modifier sign=true}}</a>
      </div>
    </div>
    {{/if}}

  {{/ifCond}}
  {{/each}}
</div>