<form id="systems-builder" class="dialog-v13 dialog-content standard-form scrollable {{cssClass}}">
  <h4 class="divider">{{localize (concat "dc20rpg.dialog.systemsBuilder." type ".title")}}</h4>

  <fieldset>
    {{#each fields}}
    {{> "systems/dc20rpg/templates/dialogs/shared/extra-field.hbs" this}}
    {{/each}}
  </fieldset>

  <footer class="form-footer">
    <button data-action="save"><i class="fa-solid fa-floppy-disk fa-lg margin-right-5"></i>{{localize "dc20rpg.dialog.display.save"}}</button>
  </footer>
</form>